# ============================================================
# EduAgent 环境变量模板
# 使用方式：cp .env.example .env.local 后填入真实值
# .env.local 已加入 .gitignore，绝不提交 Git
# ============================================================

# ===== 数据库（PostgreSQL）=====
DB_HOST=localhost
DB_PORT=5433
DB_NAME=eduagent
DB_USER=eduagent_user
DB_PASSWORD=your_db_password

# ===== Milvus =====
MILVUS_HOST=localhost
MILVUS_PORT=19531

# ===== 大模型 API =====
# 必填：DeepSeek API Key（https://platform.deepseek.com）
DEEPSEEK_API_KEY=your_deepseek_api_key
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL_CHAT=deepseek-chat
DEEPSEEK_MODEL_CODER=deepseek-coder

# 通义千问 API Key（VL 视觉模型使用）
#QWEN_API_KEY=your_qwen_api_key
#QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
#QWEN_MODEL_VL=qwen3-vl-plus

# ===== 本地模型路径 =====
RERANKER_MODEL_PATH=models/reranker/bge-reranker-large
CLASSIFIER_MODEL_PATH=models/classifier/all-MiniLM-L6-v2
FINETUNED_CLASSIFIER_PATH=models/classifier/finetune
BGE_M3_MODEL_PATH=models/embedding/bge-m3

# ===== JWT 认证（可用 `openssl rand -hex 32` 生成）=====
JWT_SECRET_KEY=your_jwt_secret_key
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=10080
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ===== Langfuse（下阶段启用，本阶段留空）=====
#LANGFUSE_SECRET_KEY=
#LANGFUSE_PUBLIC_KEY=
#LANGFUSE_HOST=http://localhost:3001

# ===== LLM 速率限制（防止 API 费用失控）=====
# 每位学员每日 LLM 调用上限（Redis 计数，超限返回友好提示）
# 生产阶段按实际用量调整；本地开发可设置为 0（0 = 不限制）
LLM_DAILY_LIMIT_PER_STUDENT=0

# ===== 应用配置 =====
APP_ENV=local
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# ===== 多租户默认值（本地开发用）=====
DEFAULT_TENANT_ID=tenant_default

# ===== 联网搜索（Tavily）=====
TAVILY_API_KEY=your_tavily_api_key
